CONTAINER_EXTERNAL_PORT=             # this is mandatory to tell the container to which host port map the `API_PORT`

# These goose variables are useful to make goose commands smaller
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=                      # this can be equal to `DATABASE_CONNECTION_STRING` if you run both goose and the db in the same network (either host machine or containers)
GOOSE_MIGRATION_DIR=./migrations

# Postgres container
POSTGRES_USER=                       # super postgres user username
POSTGRES_PASSWORD=                   # super postgres user password
POSTGRES_DB=                         # postgres database name

# Api container
DATABASE_CONNECTION_STRING=          # this is mandatory for the api to connect to the database container
API_PORT=                            # this is mandatory to tell the container in which port the api is listening
API_READ_TIMEOUT=
API_WRITE_TIMEOUT=
API_SHUTDOWN_TIMEOUT=
DB_MAX_CONNECTIONS=
DB_MIN_CONNECTIONS=
DB_MAX_CONN_LIFETIME=
DB_MAX_CONN_IDLE_TIME=

# Mapbox server-side (reverse geocoding for start/finish city auto-fill)
MAPBOX_ACCESS_TOKEN=                 # optional; when empty, city auto-fill is disabled

# Auth — API side (OIDC token validation). Defaults in docker-compose.yml work out of the box.
KEYCLOAK_ISSUER_URL=                 # mandatory; public realm URL matching token `iss` (e.g. http://localhost:8081/realms/reccelog)
KEYCLOAK_DISCOVERY_URL=              # optional; in-network URL the API uses for OIDC discovery/JWKS (e.g. http://keycloak:8080/realms/reccelog). Defaults to KEYCLOAK_ISSUER_URL
KEYCLOAK_AUDIENCE=                   # optional; expected token `aud` claim (e.g. reccelog-api). Empty skips the audience check

# Auth — Keycloak container (runs in this compose). All optional; defaults shown in docker-compose.yml.
KC_ADMIN=                            # bootstrap admin username (default: admin)
KC_ADMIN_PASSWORD=                   # bootstrap admin password (default: admin)
KC_HOSTNAME=                         # public base URL, drives token `iss` (default: http://localhost:8081)
KC_PORT=                             # host port mapped to Keycloak's 8080 (default: 8081)
KC_DB_USER=                          # Keycloak DB user (default: keycloak)
KC_DB_PASSWORD=                      # Keycloak DB password (default: keycloak)
KC_DB_NAME=                          # Keycloak DB name (default: keycloak)
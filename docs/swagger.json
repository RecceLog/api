        "application/json"
    ],
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Routes, note sets and notes for the RecceLog application.",
        "title": "RecceLog API",
        "contact": {
            "name": "RecceLog"
        },
        "license": {
            "name": "Proprietary"
        },
        "version": "0.1"
    },
    "host": "localhost:8080",

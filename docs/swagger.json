        "/v1/routes/range/{radius}": {
            "get": {
                "description": "Spatial search using PostGIS ST_DWithin + GIST index. Center is read from headers, radius is the path param (meters). Optionally filter by vehicle: pass one or more `vehicle` query params (e.g. ?vehicle=CAR\u0026vehicle=BIKE) to return only routes traversable by at least one of them.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "routes"
                ],
                "summary": "List routes within a radius",
                "parameters": [
                    {
                        "type": "number",
                        "description": "Search radius in meters",
                        "name": "radius",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "Filter: routes traversable by at least one of these vehicles",
                        "name": "vehicle",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Center latitude (WGS84)",
                        "name": "Latitude",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "Center longitude (WGS84)",
                        "name": "Longitude",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_RecceLog_api_internal_http_dto.RouteSummaryResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid radius or missing headers",
                        "schema": {
                            "$ref": "#/definitions/github_com_RecceLog_api_internal_http_problem.Problem"
                        }
                    },
                    "422": {
                        "description": "Coordinates out of range, radius too large or invalid vehicle",
                        "schema": {
                            "$ref": "#/definitions/github_com_RecceLog_api_internal_http_problem.Problem"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_RecceLog_api_internal_http_problem.Problem"
                        }
                    }
                }
            }
        },
